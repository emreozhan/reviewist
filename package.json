{
  "name": "reviewist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Java odakli yerel kod inceleme araci (kaynak kod; npm install ile derlenir)",
  "license": "MIT",
  "author": "EmreOzhan",
  "keywords": [
    "code-review",
    "java",
    "git",
    "diff",
    "tree-sitter",
    "pull-request"
  ],
  "bin": {
    "reviewist": "bin/reviewist.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "node scripts/build.mjs",
    "start": "node bin/reviewist.js",
    "build": "node scripts/build.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "dev:server": "tsx watch src/server/cli.ts --no-open --port 4317",
    "dev:web": "vite"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "@tanstack/react-query": "^5.104.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@xyflow/react": "^12.12.0",
    "diff": "^9.0.0",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tar": "^7.5.22",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "web-tree-sitter": "^0.27.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  }
}
