{
  "name": "reviewist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Java odakli yerel kod inceleme araci (iki bagimsiz uygulama: local/ ve github/) - gelistirme calisma alani",
  "license": "MIT",
  "author": "EmreOzhan",
  "keywords": [
    "code-review",
    "java",
    "git",
    "diff",
    "tree-sitter",
    "pull-request"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:local": "node scripts/build.mjs local",
    "build:github": "node scripts/build.mjs github",
    "start": "node local/bin/reviewist-local.js",
    "start:local": "node local/bin/reviewist-local.js",
    "start:github": "node github/bin/reviewist-github.js",
    "dev:local": "tsx watch local/src/cli.ts --no-open --port 4317",
    "dev:github": "tsx watch github/src/cli.ts --no-open --port 4318",
    "dev:web": "vite",
    "dev:web:github": "vite --mode github",
    "test": "vitest run",
    "test:server": "vitest run shared/src/sources shared/src/server shared/src/runtime local/src github/src",
    "test:core": "vitest run shared/src/core",
    "test:perf": "vitest run shared/src/core/java/perf.test.ts shared/src/core/perf.test.ts shared/src/core/redos.test.ts shared/src/core/navigation.test.ts shared/web/src/lib/perf.test.ts --no-file-parallelism",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p shared/web/tsconfig.json",
    "fixture": "node scripts/make-fixture.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "@tanstack/react-query": "^5.104.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@xyflow/react": "^12.12.0",
    "diff": "^9.0.0",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "web-tree-sitter": "^0.27.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  }
}
