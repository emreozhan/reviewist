{
  "name": "reviewist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Java odakli yerel kod inceleme araci: buyuk (AI kaynakli) degisiklikleri sembol duzeyinde cozer, etkiyi ve okuma sirasini gosterir",
  "license": "MIT",
  "author": "EmreOzhan",
  "keywords": [
    "code-review",
    "java",
    "git",
    "diff",
    "tree-sitter",
    "pull-request"
  ],
  "bin": {
    "reviewist": "bin/reviewist.js"
  },
  "files": [
    "bin",
    "dist",
    "vendor",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/reviewist.js",
    "build": "node scripts/build.mjs",
    "dev:server": "tsx watch src/server/cli.ts --no-open --port 4317",
    "dev:web": "vite",
    "test": "vitest run",
    "test:server": "vitest run src/sources src/server",
    "test:core": "vitest run src/core",
    "test:perf": "vitest run src/core/java/perf.test.ts src/core/perf.test.ts src/core/redos.test.ts src/core/navigation.test.ts web/src/lib/perf.test.ts --no-file-parallelism",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p web/tsconfig.json",
    "fixture": "node scripts/make-fixture.mjs",
    "smoke": "node scripts/smoke.mjs",
    "sync-branches": "node scripts/sync-branches.mjs"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "@tanstack/react-query": "^5.104.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@xyflow/react": "^12.12.0",
    "diff": "^9.0.0",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tar": "^7.5.22",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "web-tree-sitter": "^0.27.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  }
}
