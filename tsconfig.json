{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "types": [
      "node"
    ],
    "noEmit": true
  },
  "include": [
    "shared/src/**/*.ts",
    "local/src/**/*.ts",
    "github/src/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "shared/src/core/testing/**",
    "node_modules",
    "**/dist"
  ]
}
